        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2369"
                TIME_SLOT_REF1="ts1449" TIME_SLOT_REF2="ts1450">
                <ANNOTATION_VALUE>Ну вот, короче, как я и говорила, я 3 года была математикой</ANNOTATION_VALUE>
