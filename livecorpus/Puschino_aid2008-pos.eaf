            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2000"
                TIME_SLOT_REF1="ts711" TIME_SLOT_REF2="ts712">
                <ANNOTATION_VALUE>Нет, там не было ничего такого под текстом, который мы протосозреваем,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2001"
                TIME_SLOT_REF1="ts713" TIME_SLOT_REF2="ts714">
                <ANNOTATION_VALUE>но все равно это выглядело странно.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2002"
                TIME_SLOT_REF1="ts715" TIME_SLOT_REF2="ts716">
                <ANNOTATION_VALUE>Это звучит странно.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2003"
                TIME_SLOT_REF1="ts717" TIME_SLOT_REF2="ts718">
                <ANNOTATION_VALUE>Нет, у нас было забавно, что у нас был какой-то день чего-то, светлости.</ANNOTATION_VALUE>
