        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1980"
                TIME_SLOT_REF1="ts671" TIME_SLOT_REF2="ts672">
                <ANNOTATION_VALUE>А другое, честно, я правда не помню,</ANNOTATION_VALUE>
