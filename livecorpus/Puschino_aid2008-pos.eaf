        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1987"
                TIME_SLOT_REF1="ts685" TIME_SLOT_REF2="ts686">
                <ANNOTATION_VALUE>ähän а то всё 오늘은 было два человека на всю музыкальку,</ANNOTATION_VALUE>
