        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2375"
                TIME_SLOT_REF1="ts1461" TIME_SLOT_REF2="ts1462">
                <ANNOTATION_VALUE>И я типа, ну, до самого последнего думала, что я пойду когда-нибудь</ANNOTATION_VALUE>
