        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2004"
                TIME_SLOT_REF1="ts719" TIME_SLOT_REF2="ts720">
                <ANNOTATION_VALUE>Короче, нас всех нарядили в белые, дали нам свечки,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2005"
                TIME_SLOT_REF1="ts721" TIME_SLOT_REF2="ts722">
                <ANNOTATION_VALUE>и мы с этими свечками в темноте под песню</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2006"
                TIME_SLOT_REF1="ts723" TIME_SLOT_REF2="ts724">
                <ANNOTATION_VALUE>«Тихо, тихо-а-а-а-а-а-а-а-а-а-а-а-а-а-а-а-а-а-а-а-а-а-а-а-а-а-а-а-а-а».</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2007"
                TIME_SLOT_REF1="ts725" TIME_SLOT_REF2="ts726">
