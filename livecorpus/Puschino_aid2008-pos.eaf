        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2353"
                TIME_SLOT_REF1="ts1417" TIME_SLOT_REF2="ts1418">
                <ANNOTATION_VALUE>программа не очень популярная, мало кто о ней знает, попадают</ANNOTATION_VALUE>
