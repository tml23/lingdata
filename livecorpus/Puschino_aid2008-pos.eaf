        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1988"
                TIME_SLOT_REF1="ts687" TIME_SLOT_REF2="ts688">
                <ANNOTATION_VALUE>которые умели играть на белончале.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1989"
                TIME_SLOT_REF1="ts689" TIME_SLOT_REF2="ts690">
                <ANNOTATION_VALUE>И они которые учились играть на белончале.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1990"
