            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2974"
                TIME_SLOT_REF1="ts2659" TIME_SLOT_REF2="ts2660">
                <ANNOTATION_VALUE>Вот.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2975"
                TIME_SLOT_REF1="ts2661" TIME_SLOT_REF2="ts2662">
                <ANNOTATION_VALUE>Я могу просто сказать,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2976"
                TIME_SLOT_REF1="ts2663" TIME_SLOT_REF2="ts2664">
                <ANNOTATION_VALUE>что литераторы</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2977"
                TIME_SLOT_REF1="ts2665" TIME_SLOT_REF2="ts2666">
                <ANNOTATION_VALUE>это отдельные телескопы?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2978"
                TIME_SLOT_REF1="ts2667" TIME_SLOT_REF2="ts2668">
                <ANNOTATION_VALUE>Ну, можно, конечно.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2979"
                TIME_SLOT_REF1="ts2669" TIME_SLOT_REF2="ts2670">
                <ANNOTATION_VALUE>Сколько так?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2980"
                TIME_SLOT_REF1="ts2671" TIME_SLOT_REF2="ts2672">
                <ANNOTATION_VALUE>Уже почти 50 минут.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2981"
                TIME_SLOT_REF1="ts2673" TIME_SLOT_REF2="ts2674">
                <ANNOTATION_VALUE>А, ох!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2982"
                TIME_SLOT_REF1="ts2675" TIME_SLOT_REF2="ts2676">
                <ANNOTATION_VALUE>Стой, может,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2983"
                TIME_SLOT_REF1="ts2677" TIME_SLOT_REF2="ts2678">
                <ANNOTATION_VALUE>может, оно тут не остановится?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2984"
                TIME_SLOT_REF1="ts2679" TIME_SLOT_REF2="ts2680">
                <ANNOTATION_VALUE>Ну, ладно,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2985"
                TIME_SLOT_REF1="ts2681" TIME_SLOT_REF2="ts2682">
                <ANNOTATION_VALUE>я тогда предполагаю,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2986"
                TIME_SLOT_REF1="ts2683" TIME_SLOT_REF2="ts2684">
                <ANNOTATION_VALUE>что мы закончили.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2987"
                TIME_SLOT_REF1="ts2685" TIME_SLOT_REF2="ts2686">
                <ANNOTATION_VALUE>Да, я думаю, мы закончили.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2988"
                TIME_SLOT_REF1="ts2687" TIME_SLOT_REF2="ts2688">
                <ANNOTATION_VALUE>Все, тогда.</ANNOTATION_VALUE>
