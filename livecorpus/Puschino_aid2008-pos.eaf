        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2352"
                TIME_SLOT_REF1="ts1415" TIME_SLOT_REF2="ts1416">
                <ANNOTATION_VALUE>У меня такое впечатление, что сюда, из-за того, что</ANNOTATION_VALUE>
