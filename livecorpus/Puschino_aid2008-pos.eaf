        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2357"
                TIME_SLOT_REF1="ts1425" TIME_SLOT_REF2="ts1426">
                <ANNOTATION_VALUE>Почему бы не податься?</ANNOTATION_VALUE>
