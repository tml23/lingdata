        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2989"
                TIME_SLOT_REF1="ts2689" TIME_SLOT_REF2="ts2690">
                <ANNOTATION_VALUE>Ну, можно заканчивать.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2990"
                TIME_SLOT_REF1="ts2691" TIME_SLOT_REF2="ts2692">
